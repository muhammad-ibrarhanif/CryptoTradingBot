@{
    ViewData["Title"] = "Candle-by-Candle Simulation";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0d1117; color: #e6edf3; padding: 20px; }
        .container { max-width: 1600px; margin: 0 auto; }
        
        h1 { color: #00ff88; margin-bottom: 20px; }
        
        .controls { background: #161b22; border: 1px solid #30363d; border-radius: 10px; padding: 20px; margin-bottom: 20px; }
        .control-group { display: inline-block; margin-right: 15px; }
        .control-group label { display: block; font-size: 12px; color: #8b949e; margin-bottom: 5px; }
        .control-group input, .control-group select { background: #0d1117; color: #e6edf3; border: 1px solid #30363d; padding: 8px; border-radius: 5px; }
        button { background: #00ff88; color: #0d1117; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold; }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .progress-section { background: #161b22; border: 1px solid #30363d; border-radius: 10px; padding: 20px; margin-bottom: 20px; }
        .progress-bar-container { background: #0d1117; border-radius: 10px; height: 20px; overflow: hidden; }
        .progress-bar { background: #00ff88; height: 100%; width: 0%; transition: width 0.3s; }
        .progress-text { margin-top: 10px; font-size: 12px; color: #8b949e; }
        
        .timeframes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px; }
        .card { background: #161b22; border: 1px solid #30363d; border-radius: 10px; padding: 15px; }
        .card h2 { font-size: 14px; margin-bottom: 10px; }
        .chart-container { height: 200px; background: #0d1117; border-radius: 5px; margin-bottom: 10px; }
        canvas { width: 100%; height: 100%; }
        .analysis { font-size: 11px; font-family: monospace; }
        .analysis p { margin: 3px 0; }
        
        .signals-panel { background: #161b22; border: 1px solid #00ff88; border-radius: 10px; padding: 20px; margin-bottom: 20px; max-height: 300px; overflow-y: auto; }
        .signal { padding: 8px; margin: 5px 0; border-radius: 5px; font-size: 12px; }
        .signal-buy { background: rgba(0, 255, 136, 0.1); border-left: 3px solid #00ff88; }
        .signal-sell { background: rgba(255, 68, 68, 0.1); border-left: 3px solid #ff4444; }
        
        .status { background: #0d1117; padding: 10px; border-radius: 5px; font-size: 12px; }
        .trend-up { color: #00ff88; }
        .trend-down { color: #ff4444; }
    </style>
</head>
<body>
    <div class="container">
        <h1>📊 Candle-by-Candle Simulation</h1>
        
        <div class="controls">
            <div class="control-group">
                <label>Symbol</label>
                <select id="symbol">
                    <option value="SOLUSDT">SOL/USDT</option>
                    <option value="BTCUSDT">BTC/USDT</option>
                    <option value="ETHUSDT">ETH/USDT</option>
                </select>
            </div>
            <div class="control-group">
                <label>Start Date</label>
                <input type="date" id="startDate" value="2026-04-30" />
            </div>
            <div class="control-group">
                <label>End Date</label>
                <input type="date" id="endDate" value="2026-05-01" />
            </div>
            <div class="control-group">
                <label>Speed (ms)</label>
                <input type="number" id="speed" value="100" min="10" max="1000" />
            </div>
            <button id="startBtn">▶ Start Simulation</button>
            <button id="stopBtn" disabled>⏹ Stop</button>
        </div>
        
        <div class="progress-section">
            <div class="progress-bar-container">
                <div class="progress-bar" id="progressBar"></div>
            </div>
            <div class="progress-text" id="progressText">Ready to start</div>
        </div>
        
        <div class="timeframes">
            <div class="card">
                <h2>📈 1-HOUR CHART</h2>
                <div class="chart-container"><canvas id="canvas-1h" width="400" height="200"></canvas></div>
                <div class="analysis" id="analysis-1h"></div>
            </div>
            <div class="card">
                <h2>⏱️ 15-MINUTE CHART</h2>
                <div class="chart-container"><canvas id="canvas-15m" width="400" height="200"></canvas></div>
                <div class="analysis" id="analysis-15m"></div>
            </div>
            <div class="card">
                <h2>🔥 5-MINUTE CHART</h2>
                <div class="chart-container"><canvas id="canvas-5m" width="400" height="200"></canvas></div>
                <div class="analysis" id="analysis-5m"></div>
            </div>
        </div>
        
        <div class="signals-panel">
            <h2>🎯 SIGNAL LOG</h2>
            <div id="signals-log"></div>
        </div>
        
        <div class="status" id="status"></div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        let connection = null;
        let isRunning = false;
        
        // Chart data storage
        let chartData = {
            candles1H: [],
            candles15M: [],
            candles5M: []
        };
        
        // Initialize SignalR connection
        connection = new signalR.HubConnectionBuilder()
            .withUrl("/simulationHub")
            .build();
        
        connection.on("ReceiveState", function(state) {
            updateUI(state);
        });
        
        connection.on("ReceiveSignal", function(signal) {
            addSignalToLog(signal);
        });
        
        connection.on("ReceiveProgress", function(progress) {
            updateProgress(progress.current, progress.total, progress.message);
        });
        
        connection.on("ReceiveComplete", function(complete) {
            isRunning = false;
            document.getElementById("startBtn").disabled = false;
            document.getElementById("stopBtn").disabled = true;
            document.getElementById("status").innerHTML = `✅ Simulation Complete! Trades: ${complete.totalTrades} | Wins: ${complete.winningTrades} | Win Rate: ${complete.winRate.toFixed(1)}%`;
        });
        
        connection.on("ReceiveError", function(error) {
            document.getElementById("status").innerHTML = `❌ Error: ${error.message}`;
            isRunning = false;
            document.getElementById("startBtn").disabled = false;
            document.getElementById("stopBtn").disabled = true;
        });
        
        connection.start().then(function() {
            console.log("SignalR connected");
        }).catch(function(err) {
            console.error("SignalR error:", err);
        });
        
        function updateUI(state) {
            // Update charts
            chartData.candles1H = state.candles1H;
            chartData.candles15M = state.candles15M;
            chartData.candles5M = state.candles5M;
            
            drawChart('canvas-1h', chartData.candles1H);
            drawChart('canvas-15m', chartData.candles15M);
            drawChart('canvas-5m', chartData.candles5M);
            
            // Update analysis
            if (state.analysis1H) {
                document.getElementById("analysis-1h").innerHTML = `
                    <p>Trend: <span class="${state.analysis1H.trend?.includes('DOWN') ? 'trend-down' : 'trend-up'}">${state.analysis1H.trend || 'N/A'}</span></p>
                    <p>Support: ${state.analysis1H.support?.toFixed(4) || 'N/A'}</p>
                    <p>Resistance: ${state.analysis1H.resistance?.toFixed(4) || 'N/A'}</p>
                    <p>Pattern: ${state.analysis1H.pattern || 'N/A'}</p>
                `;
            }
            
            if (state.analysis15M) {
                document.getElementById("analysis-15m").innerHTML = `
                    <p>Trend: <span class="${state.analysis15M.trend?.includes('DOWN') ? 'trend-down' : 'trend-up'}">${state.analysis15M.trend || 'N/A'}</span></p>
                    <p>Support: ${state.analysis15M.support?.toFixed(4) || 'N/A'} ${state.analysis15M.nearSupport ? '← NEAR' : ''}</p>
                    <p>Resistance: ${state.analysis15M.resistance?.toFixed(4) || 'N/A'} ${state.analysis15M.nearResistance ? '← NEAR' : ''}</p>
                    <p>Pattern: ${state.analysis15M.pattern || 'N/A'}</p>
                `;
            }
            
            if (state.analysis5M) {
                document.getElementById("analysis-5m").innerHTML = `
                    <p>Trend: <span class="${state.analysis5M.trend?.includes('DOWN') ? 'trend-down' : 'trend-up'}">${state.analysis5M.trend || 'N/A'}</span></p>
                    <p>Support: ${state.analysis5M.support?.toFixed(4) || 'N/A'} ${state.analysis5M.nearSupport ? '← NEAR' : ''}</p>
                    <p>Resistance: ${state.analysis5M.resistance?.toFixed(4) || 'N/A'} ${state.analysis5M.nearResistance ? '← NEAR' : ''}</p>
                    <p>Pattern: ${state.analysis5M.pattern || 'N/A'}</p>
                `;
            }
            
            // Update status
            document.getElementById("status").innerHTML = `
                📍 ${state.statusMessage || 'Processing'} | Time: ${state.currentTime || 'N/A'} | Candle: ${state.currentCandle}/${state.totalCandles}
            `;
        }
        
        function addSignalToLog(signal) {
            const logDiv = document.getElementById("signals-log");
            const signalDiv = document.createElement("div");
            signalDiv.className = `signal signal-${signal.type.toLowerCase()}`;
            signalDiv.innerHTML = `
                <strong>${signal.type} SIGNAL ★${signal.strength}</strong> at ${new Date(signal.time).toLocaleTimeString()}<br>
                ${signal.pattern}<br>
                Price: ${signal.price.toFixed(4)}<br>
                ${signal.message}
                <hr style="margin: 5px 0; border-color: #30363d;">
            `;
            logDiv.insertBefore(signalDiv, logDiv.firstChild);
            
            // Limit log size
            while (logDiv.children.length > 50) {
                logDiv.removeChild(logDiv.lastChild);
            }
        }
        
        function updateProgress(current, total, message) {
            const percent = total > 0 ? (current / total * 100) : 0;
            document.getElementById("progressBar").style.width = `${percent}%`;
            document.getElementById("progressText").innerHTML = `${message} (${current}/${total})`;
        }
        
        function drawChart(canvasId, candles) {
            const canvas = document.getElementById(canvasId);
            if (!canvas || !candles || candles.length === 0) return;
            
            const ctx = canvas.getContext('2d');
            const width = canvas.clientWidth;
            const height = canvas.clientHeight;
            canvas.width = width;
            canvas.height = height;
            
            ctx.clearRect(0, 0, width, height);
            
            // Get last 50 candles for display
            const displayCandles = candles.slice(-50);
            if (displayCandles.length === 0) return;
            
            let minPrice = Math.min(...displayCandles.map(c => c.low));
            let maxPrice = Math.max(...displayCandles.map(c => c.high));
            let padding = (maxPrice - minPrice) * 0.1;
            minPrice -= padding;
            maxPrice += padding;
            let priceRange = maxPrice - minPrice;
            
            const candleWidth = Math.max(2, Math.min(6, (width / displayCandles.length) - 1));
            const candleSpacing = candleWidth + 1;
            
            for (let i = 0; i < displayCandles.length; i++) {
                const candle = displayCandles[i];
                const x = i * candleSpacing;
                
                const highY = height - ((candle.high - minPrice) / priceRange) * height;
                const lowY = height - ((candle.low - minPrice) / priceRange) * height;
                const openY = height - ((candle.open - minPrice) / priceRange) * height;
                const closeY = height - ((candle.close - minPrice) / priceRange) * height;
                
                const isBullish = candle.close > candle.open;
                ctx.fillStyle = isBullish ? '#00ff88' : '#ff4444';
                ctx.strokeStyle = isBullish ? '#00ff88' : '#ff4444';
                
                // Draw wick
                ctx.beginPath();
                ctx.moveTo(x + candleWidth / 2, highY);
                ctx.lineTo(x + candleWidth / 2, lowY);
                ctx.stroke();
                
                // Draw body
                const bodyTop = Math.min(openY, closeY);
                const bodyHeight = Math.max(1, Math.abs(closeY - openY));
                ctx.fillRect(x, bodyTop, candleWidth, bodyHeight);
            }
        }
        
        // Start button handler
        document.getElementById("startBtn").addEventListener("click", async function() {
            const symbol = document.getElementById("symbol").value;
            const startDate = document.getElementById("startDate").value;
            const endDate = document.getElementById("endDate").value;
            const speed = parseInt(document.getElementById("speed").value);
            
            isRunning = true;
            document.getElementById("startBtn").disabled = true;
            document.getElementById("stopBtn").disabled = false;
            document.getElementById("signals-log").innerHTML = "";
            document.getElementById("progressBar").style.width = "0%";
            
            const response = await fetch("/Simulation/StartSimulation", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ symbol, startDate, endDate, speedMs: speed })
            });
        });
        
        // Stop button handler
        document.getElementById("stopBtn").addEventListener("click", function() {
            isRunning = false;
            document.getElementById("startBtn").disabled = false;
            document.getElementById("stopBtn").disabled = true;
            document.getElementById("status").innerHTML = "⏹ Simulation stopped by user";
        });
        
        // Resize handler
        window.addEventListener('resize', function() {
            drawChart('canvas-1h', chartData.candles1H);
            drawChart('canvas-15m', chartData.candles15M);
            drawChart('canvas-5m', chartData.candles5M);
        });
    </script>
</body>
</html>